# Production template for a single Contabo VPS.
# Copy to .env.prod and replace every "replace-..." value before deploy.
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Use URL-safe values for POSTGRES_PASSWORD because it is embedded in DATABASE_URL.

COMPOSE_PROJECT_NAME=crm_layer_prod
DOMAIN=crm.example.com
ACME_EMAIL=admin@example.com
APP_ENV=production
SERVICE_NAME=api
APP_VERSION=0.1.0
GIT_COMMIT=unknown
BUILD_DATE=unknown
PUBLIC_APP_URL=https://crm.example.com
API_BASE_URL=https://crm.example.com
NEXT_PUBLIC_API_BASE_URL=https://crm.example.com

DJANGO_SETTINGS_MODULE=crm.config.settings.prod
SECRET_KEY=replace-with-token-urlsafe-64-minimum-50-chars
JWT_SIGNING_KEY=replace-with-token-urlsafe-48-minimum-32-bytes
DEBUG=false
ALLOWED_HOSTS=crm.example.com
CORS_ALLOWED_ORIGINS=https://crm.example.com
CSRF_TRUSTED_ORIGINS=https://crm.example.com
LOG_LEVEL=INFO
API_DEFAULT_PAGE_SIZE=50
DATABASE_CONN_MAX_AGE=60
CACHE_URL=redis://redis:6379/1
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
DRF_ANON_THROTTLE_RATE=60/minute
DRF_USER_THROTTLE_RATE=600/minute
DRF_LOGIN_THROTTLE_RATE=10/minute
DRF_PROSPECTING_THROTTLE_RATE=20/hour
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=true

POSTGRES_DB=ai_crm
POSTGRES_USER=ai_crm
POSTGRES_PASSWORD=replace-with-url-safe-db-password
DATABASE_URL=postgres://ai_crm:replace-with-url-safe-db-password@postgres:5432/ai_crm

REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=86400
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
HEALTHCHECK_REDIS_TIMEOUT_SECONDS=1.0

OUTBOX_PROCESS_INTERVAL_SECONDS=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_STALE_LOCK_SECONDS=300
TASK_REMINDER_INTERVAL_SECONDS=60
TASK_ESCALATION_INTERVAL_SECONDS=300
NOTIFICATION_DIGEST_INTERVAL_SECONDS=86400
OBSERVABILITY_HEALTH_INTERVAL_SECONDS=300
PROSPECTING_FOLLOWUP_INTERVAL_SECONDS=21600

WHATSAPP_VERIFY_TOKEN=replace-with-token-urlsafe-32
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_REQUEST_TIMEOUT_SECONDS=10
WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
OWNER_WHATSAPP_NUMBER=5490000000000

ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
BACKEND_URL=http://api:8000
WA_BRIDGE_URL=http://wa-bridge:3001
WA_BRIDGE_SHARED_SECRET=replace-with-token-urlsafe-48-minimum-32-bytes

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_CAP=90
APOLLO_API_KEY=
APOLLO_DAILY_CAP=50
APOLLO_MONTHLY_CAP=500
HUNTER_API_KEY=
HUNTER_MONTHLY_CAP=40

MEDIA_STORAGE_PROVIDER=local
MEDIA_PRIVATE_ROOT=/app/apps/api/private_media
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=crm-layer/postgres
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
