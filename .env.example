# Local development template. Do not use these values in production.

# Project
COMPOSE_PROJECT_NAME=ai_crm
DOMAIN=localhost
ACME_EMAIL=admin@example.com
APP_ENV=local
SERVICE_NAME=api
APP_VERSION=0.1.0
GIT_COMMIT=local
BUILD_DATE=local
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Django
DJANGO_SETTINGS_MODULE=crm.config.settings.local
SECRET_KEY=local-development-secret-key-change-me
JWT_SIGNING_KEY=local-jwt-signing-key-at-least-32-bytes
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
API_DEFAULT_PAGE_SIZE=50
DATABASE_CONN_MAX_AGE=60
CACHE_URL=redis://redis:6379/1
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
DRF_ANON_THROTTLE_RATE=60/minute
DRF_USER_THROTTLE_RATE=600/minute
DRF_LOGIN_THROTTLE_RATE=10/minute
DRF_PROSPECTING_THROTTLE_RATE=20/hour
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=true

# PostgreSQL
POSTGRES_DB=ai_crm
POSTGRES_USER=ai_crm
POSTGRES_PASSWORD=ai_crm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://ai_crm:ai_crm@postgres:5432/ai_crm

# Redis / Celery
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=86400
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
HEALTHCHECK_REDIS_TIMEOUT_SECONDS=1.0

# Scheduled jobs
OUTBOX_PROCESS_INTERVAL_SECONDS=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_STALE_LOCK_SECONDS=300
TASK_REMINDER_INTERVAL_SECONDS=60
TASK_ESCALATION_INTERVAL_SECONDS=300
NOTIFICATION_DIGEST_INTERVAL_SECONDS=86400
OBSERVABILITY_HEALTH_INTERVAL_SECONDS=300
PROSPECTING_FOLLOWUP_INTERVAL_SECONDS=21600

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_REQUEST_TIMEOUT_SECONDS=10
WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
OWNER_WHATSAPP_NUMBER=5490000000000

# WhatsApp bridge
ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
BACKEND_URL=http://api:8000
WA_BRIDGE_URL=http://wa-bridge:3001
WA_BRIDGE_SHARED_SECRET=local-wa-bridge-secret-at-least-32-bytes

# AI providers
AI_DEFAULT_TEXT_PROVIDER=openai
AI_DEFAULT_TRANSCRIPTION_PROVIDER=openai
AI_DEFAULT_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cazador providers
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_CAP=90
APOLLO_API_KEY=
APOLLO_DAILY_CAP=50
APOLLO_MONTHLY_CAP=500
HUNTER_API_KEY=
HUNTER_MONTHLY_CAP=40

# Object storage / private media
MEDIA_STORAGE_PROVIDER=local
MEDIA_PRIVATE_ROOT=
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=crm-layer/postgres
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Optional error tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
