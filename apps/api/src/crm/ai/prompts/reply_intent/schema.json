{
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "confidence", "reasoning", "next_action"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["interested", "not_interested", "maybe", "do_not_contact", "unclear"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasoning": { "type": "string" },
    "next_action": {
      "type": "string",
      "enum": [
        "ask_qualifying",
        "propose_call",
        "send_info",
        "rebut_objection",
        "schedule_followup",
        "handoff_human",
        "none"
      ]
    },
    "objection_type": { "type": "string" }
  }
}
